@startuml

class Vector {
  + Coordinates : double[] {get, set}
  + Dimensions : int {get}
  + Add(x : Vector) : Vector
  + Subtract(x : Vector) : Vector
  + ScalarProduct(x : Vector) : double
}
class Vector3D extends Vector  {
  + CrossProduct(x : Vector3D) : Vector3D
}

class Matrix {
  + Coordinates : double[][] {get, set}
  + Rows : int {get}
  + Columns : int {get}
  + ScalarProduct(y : double) : Matrix
  + Transpose() : Matrix

}
class SquaredMatrix extends Matrix{
  + Inverse() : SquaredMatrix
  + Determinant() : double
  + Trace() : double
  + EigenValues() : double[]
  + EigenVectors() : Vector[]

}
class Transformation {
  # TransformationMatrix : Matrix {get, set}
  + Transform(v : Vector) : Vector
}

interface IRenderer {
  + Render(v : Vector) : void
  + Render(m : Matrix) : void
}

Transformation *-- Matrix : uses
Transformation ..> Vector : transforms
IRenderer ..> Vector : renders
IRenderer ..> Matrix : renders

@enduml